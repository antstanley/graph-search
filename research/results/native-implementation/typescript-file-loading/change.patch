+
+    #[test]
+    fn json_declaration_wrappers_runtime_families_and_custom_extensions_are_distinct() {
+        let known = files(&[
+            "x.d.mts",
+            "y.cts",
+            "data.json",
+            "style.d.css.ts",
+            "double.js.ts",
