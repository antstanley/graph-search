+    #[test]
+    fn rejected_structure_yields_bounded_fragments_near_unseen_matches() {
+        use crate::ports::GraphStore;
+        let root = tempfile::tempdir().unwrap();
+        let lines: Vec<_> = (1..=40)
+            .map(|line| format!("line {line:02}: café \"{}\"", "x".repeat(45)))
+            .collect();
+        std::fs::write(root.path().join("a.rs"), lines.join("\n")).unwrap();
+        let mut sources = SourceCache::new(8192, 8192);
+        assert!(sources.read(root.path(), "a.rs").is_some());
+        let mut node = SymbolHit::of(&Node {
+            path: "a.rs".into(),
+            ..Node::default()
+        });
+        node.start_line = 1;
+        node.end_line = 40;
+        let contexts = BTreeMap::from([(
+            graph_search_types::NodeId::new(&node.id),
+            MatchContext {
+                omitted_regions: 0,
+                regions: vec![MatchRegion {
+                    span: graph_search_types::Span {
+                        start_line: 1,
+                        end_line: 40,
+                        ..Default::default()
+                    },
+                    lines: BTreeMap::from([(36, 1)]),
+                    headings: Vec::new(),
+                    fence: None,
+                    table: None,
+                }],
+            },
+        )]);
+        let base = ExploreResult {
+            items: vec![ExploreItem {
+                node,
+                snippet: Some(Snippet {
+                    source_hash: sources.hash("a.rs").unwrap().into(),
+                    start_line: 1,
+                    lines: vec![lines[0].clone()],
+                }),
+                retrieval: None,
+                excerpts: Vec::new(),
+                evidence: None,
+                impact: None,
+            }],
+            ..ExploreResult::default()
+        };
+        let store = crate::memory::MemoryStore::new();
+        let snapshot = store.snapshot().unwrap();
+        for extra in [1200, 1500, 1900, 4000] {
+            let cap = encoded_len(&base) + extra;
+            let mut result = base.clone();
+            let mut work = WorkBudget::new(crate::work::WorkLimits::default());
+            extend(
+                &mut result,
+                &sources,
+                cap,
+                &mut work,
+                snapshot.as_ref(),
+                &contexts,
+            )
+            .unwrap();
+            result.stats.context_windows_examined = work.context_windows_examined();
+            result.stats.elapsed_ms = u64::MAX;
+            assert!(encoded_len(&result) <= cap);
+            let mut seen = BTreeSet::from([1]);
+            for excerpt in &result.items[0].excerpts {
+                assert_eq!(excerpt.snippet.source_hash, sources.hash("a.rs").unwrap());
+                for (offset, text) in excerpt.snippet.lines.iter().enumerate() {
+                    let line = excerpt.snippet.start_line + u32::try_from(offset).unwrap();
+                    assert!(seen.insert(line), "duplicate line {line}");
+                    assert_eq!(text, &lines[line as usize - 1]);
+                }
+            }
+            assert!(
+                seen.contains(&36),
+                "unseen match survives at extra budget {extra}"
+            );
+            if extra == 4000 {
+                assert_eq!(seen.len(), 40, "complete structure still wins when it fits");
+            } else {
+                assert!(seen.len() < 40);
+                assert!(
+                    result
+                        .truncations
+                        .iter()
+                        .any(|t| t.kind == TruncationKind::Snippet)
+                );
+            }
+        }
     }
 
