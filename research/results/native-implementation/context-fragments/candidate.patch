+
+// At most four bisections for an 80-line interval: the existing five-line
+// match neighborhoods handle smaller fragments. Both halves compete by their
+// remaining terms and byte cost, rather than always retaining a prefix. Scaling
+// value by length prevents subdivision from manufacturing extra relevance.
+fn split_candidate(candidate: &Candidate, start: u32, end: u32, into: &mut Vec<Candidate>) {
+    let length = end.saturating_sub(start).saturating_add(1);
+    if length <= 5 {
+        return;
+    }
+    let middle = start.saturating_add(length.saturating_sub(1).checked_div(2).unwrap_or(0));
+    let original = u64::from(
+        candidate
+            .end
+            .saturating_sub(candidate.start)
+            .saturating_add(1),
+    );
+    for (start, end) in [(start, middle), (middle.saturating_add(1), end)] {
+        into.push(Candidate {
+            item: candidate.item,
+            start,
+            end,
+            role: candidate.role,
+            value: candidate
+                .value
+                .saturating_mul(u64::from(end.saturating_sub(start).saturating_add(1)))
+                .checked_div(original)
+                .unwrap_or(0),
+            utility: 0,
+            bytes: 0,
+        });
+    }
 }
 
